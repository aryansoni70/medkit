# ========================================================
# MedKit - Environment Configuration
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Local SQLite (Development default):
DATABASE_URL="file:./dev.db"

# Production PostgreSQL (Neon / Supabase / Self-hosted):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medkit?schema=public"

# Authentication & Security
JWT_SECRET="medkit_super_secret_jwt_key_for_development_purposes_only_32chars"
JWT_EXPIRES_IN="7d"
COOKIE_SECRET="medkit_secure_cookie_secret_salt_value_here"

# Frontend URLs & CORS
CLIENT_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:5000/api/v1"
NEXT_PUBLIC_SOCKET_URL="http://localhost:5000"

# Geolocation Defaults (Indore, Madhya Pradesh)
DEFAULT_LATITUDE=22.7533
DEFAULT_LONGITUDE=75.8937
DEFAULT_RADIUS_KM=5

# Stock Freshness Thresholds (Hours)
FRESH_STOCK_THRESHOLD_HOURS=6
STALE_STOCK_THRESHOLD_HOURS=24
